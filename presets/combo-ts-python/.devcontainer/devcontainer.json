{
  "name": "combo-ts-python",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers-extra/features/mise:1": {}
  },
  "postCreateCommand": "mise trust && mise install",
  "forwardPorts": [
    5173,
    8000
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "hverlin.mise-vscode",
        "dbaeumer.vscode-eslint",
        "biomejs.biome",
        "ms-python.python",
        "charliermarsh.ruff"
      ]
    }
  },
  "remoteUser": "vscode"
}
