{
  "name": "python",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": { "ghcr.io/devcontainers-extra/features/mise:1": {} },
  "postCreateCommand": "mise trust && mise install",
  "customizations": {
    "vscode": {
      "extensions": ["hverlin.mise-vscode", "ms-python.python", "charliermarsh.ruff"]
    }
  },
  "remoteUser": "vscode"
}
